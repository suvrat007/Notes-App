# Copy to .env for local development. On Render these are set in the
# dashboard instead (Environment -> Environment Variables).
#
# The two marked CROSS-ORIGIN are the ones that differ between running this
# on your machine and running it behind a deployed frontend. Getting either
# wrong fails silently in the browser, so they are worth reading twice.

# ---- database ----
# The Atlas connection string. NOTE: local development points at this same
# cluster, so anything you create while developing is real production data.
# A separate cluster (or at least a separate database name) for development
# is worth the ten minutes it takes to set up.
VITE_MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/notes-app

# Signs the auth cookie. Any long random string; changing it logs everyone out.
ACCESS_TOKEN_SECRET=

# ---- Google sign-in ----
# The SAME client id the frontend uses. The server checks that a token was
# issued to this application before trusting a word of it, so a mismatch here
# rejects every Google login.
GOOGLE_CLIENT_ID=

# ---- CROSS-ORIGIN: which frontends may call this API ----
# Comma separated, scheme + host, no path and no trailing slash. Spaces after
# the commas are fine. Unset, it allows only the two localhost dev ports, so a
# deployed frontend gets blocked by CORS with no other symptom.
#
#   local:  http://localhost:5173,http://localhost:5174
#   Render: https://your-frontend.vercel.app
#
# The service prints "[cors] allowing: ..." at boot. If your domain is not in
# that line, the variable never reached the process.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# ---- CROSS-ORIGIN: how the auth cookie is written ----
# Render does NOT set this for you, and the default is not production.
#
# In production the cookie is written Secure + SameSite=None, which is what a
# browser requires before it will store a cookie from a different site. Leave
# this unset on Render and login returns 200, the cookie is dropped on the
# floor, and the very next request is a 401 with nothing in the console to
# explain why.
#
#   local:  development
#   Render: production
NODE_ENV=development

# ---- optional ----
# Render provides PORT itself; only set it locally if 8000 is taken.
# PORT=8000

# Some networks refuse the SRV lookup a mongodb+srv:// URI needs, which
# surfaces as "querySrv ECONNREFUSED". Point Node at resolvers that answer.
# DNS_SERVERS=8.8.8.8,1.1.1.1
