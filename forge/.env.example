# Copy to .env and fill in. NEVER commit the real .env.
# NOTE: Vite inlines VITE_* into the client bundle - this key is readable
# by anyone who can open the built app. Personal installs only.
VITE_GROQ_API_KEY=

# Google Calendar / Tasks sync (optional - the .ics export works without it).
#
# Unlike the key above, an OAuth *client ID* is public by design; Google's
# browser flow requires it in the page. There is no client secret in this flow
# and you must never add one here.
#
# Setup:
#   1. console.cloud.google.com -> new project
#   2. APIs & Services -> Library -> enable "Google Calendar API" and
#      "Google Tasks API"
#   3. OAuth consent screen -> External -> add yourself under Test users
#   4. Credentials -> Create credentials -> OAuth client ID -> Web application
#   5. Authorized JavaScript origins: http://localhost:5173 (plus your
#      deployed origin). No redirect URI is needed - the GIS token flow
#      doesn't use one.
#
# Scopes requested: calendar.events + tasks. Both are "sensitive", so a
# publicly distributed build needs Google's OAuth verification. A personal
# install can stay in Testing mode indefinitely.
VITE_GOOGLE_CLIENT_ID=
