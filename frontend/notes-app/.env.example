# Copy to .env for local development, then fill in.
# Vite only exposes variables prefixed VITE_, and it inlines them at BUILD
# time - so changing one means restarting the dev server or rebuilding.

# Where the backend lives. Use the local one while developing, or every test
# run and every stray click writes into the deployed database.
VITE_API_URL=http://localhost:8000

# Google sign-in. Public - it ships in the bundle. Register the exact origin
# under "Authorized JavaScript origins" in the Google Cloud console.
VITE_GOOGLE_CLIENT_ID=

# Whisper + Llama for voice entry. Leave blank to hide voice input entirely.
VITE_GROQ_API_KEY=
